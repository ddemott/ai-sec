[
  {
    "type": "function",
    "function": {
      "name": "get_customer_context",
      "description": "Retrieves the history and context for a customer based on their phone number. Call this at the start of every conversation to see if they are a returning caller.",
      "parameters": {
        "type": "object",
        "properties": {
          "phone": { "type": "string", "description": "The caller's E.164 phone number." },
          "tenant_id": { "type": "string", "description": "The unique ID for the business (tenant)." }
        },
        "required": ["phone", "tenant_id"]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "check_availability",
      "description": "Checks if a specific time slot is available for booking.",
      "parameters": {
        "type": "object",
        "properties": {
          "tenant_id": { "type": "string" },
          "resource_id": { "type": "string", "description": "The ID of the truck or person to book." },
          "start_time": { "type": "string", "format": "date-time", "description": "ISO 8601 start time." },
          "end_time": { "type": "string", "format": "date-time", "description": "ISO 8601 end time." }
        },
        "required": ["tenant_id", "resource_id", "start_time", "end_time"]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "book_appointment",
      "description": "Books an appointment in the calendar. Always check availability first.",
      "parameters": {
        "type": "object",
        "properties": {
          "tenant_id": { "type": "string" },
          "resource_id": { "type": "string" },
          "phone": { "type": "string" },
          "name": { "type": "string" },
          "start_time": { "type": "string", "format": "date-time" },
          "end_time": { "type": "string", "format": "date-time" },
          "description": { "type": "string", "description": "What the appointment is for (e.g., 'Flat tire repair')." },
          "call_id": { "type": "string", "description": "Pass the 'call.id' from the conversation context." },
          "employee_id": { "type": "string", "description": "Optional: Specific employee ID to book." }
        },
        "required": ["tenant_id", "resource_id", "phone", "start_time", "end_time"]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "get_scheduling_options",
      "description": "Returns available scheduling options (resource and employee pairs) for a given service and time window.",
      "parameters": {
        "type": "object",
        "properties": {
          "tenant_id": { "type": "string" },
          "requirements": {
            "type": "object",
            "properties": {
              "serviceType": { "type": "string" },
              "requiredResourceCapabilities": { "type": "array", "items": { "type": "string" } },
              "requiredEmployeeSkills": { "type": "array", "items": { "type": "string" } }
            },
            "required": ["serviceType"]
          },
          "window": {
            "type": "object",
            "properties": {
              "from": { "type": "string", "format": "date-time" },
              "to": { "type": "string", "format": "date-time" }
            },
            "required": ["from", "to"]
          }
        },
        "required": ["tenant_id", "requirements", "window"]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "book_with_scheduling",
      "description": "Books an appointment by automatically selecting an available resource (and employee if needed) based on service requirements and a time window.",
      "parameters": {
        "type": "object",
        "properties": {
          "tenant_id": { "type": "string" },
          "phone": { "type": "string" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "call_id": { "type": "string" },
          "location": { "type": "string" },
          "requirements": {
            "type": "object",
            "properties": {
              "serviceType": { "type": "string", "description": "The type of service being requested." },
              "requiredResourceCapabilities": { "type": "array", "items": { "type": "string" } },
              "requiredEmployeeSkills": { "type": "array", "items": { "type": "string" } },
              "preferredResourceId": { "type": "string" }
            },
            "required": ["serviceType"]
          },
          "window": {
            "type": "object",
            "properties": {
              "from": { "type": "string", "format": "date-time" },
              "to": { "type": "string", "format": "date-time" }
            },
            "required": ["from", "to"]
          }
        },
        "required": ["tenant_id", "phone", "description", "call_id", "requirements", "window"]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "get_company_policy_answer",
      "description": "Searches the business knowledge base to answer policy questions (hours, payment methods, warranty, etc.).",
      "parameters": {
        "type": "object",
        "properties": {
          "tenant_id": { "type": "string" },
          "question": { "type": "string", "description": "The caller's question about business policy." }
        },
        "required": ["tenant_id", "question"]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "get_service_catalog",
      "description": "Returns the list of services offered by the business, including names, descriptions, durations, and prices.",
      "parameters": {
        "type": "object",
        "properties": {
          "tenant_id": { "type": "string" }
        },
        "required": ["tenant_id"]
      }
    }
  }
]
