{
  "name": "ai-sec-agent",
  "version": "0.1.0",
  "private": true,
  "description": "LiveKit voice agent worker for SecretaryHQ — replaces Vapi as the orchestrator between Telnyx (SIP) and Deepgram/OpenAI/xAI.",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts dev",
    "build": "tsc -p .",
    "start": "node dist/index.js start",
    "download-files": "node dist/index.js download-files",
    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run",
    "lint": "eslint . --max-warnings 999",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,json,md}\" \"*.{json,md}\" --config ../.prettierrc.json --ignore-path ../.prettierignore",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,json,md}\" \"*.{json,md}\" --config ../.prettierrc.json --ignore-path ../.prettierignore"
  },
  "dependencies": {
    "@livekit/agents": "^1.2.8",
    "@livekit/agents-plugin-deepgram": "^1.2.8",
    "@livekit/agents-plugin-openai": "^1.2.8",
    "@livekit/agents-plugin-silero": "^1.2.8",
    "@logtail/pino": "^0.5.8",
    "@sentry/node": "^10.53.1",
    "dotenv": "^17.3.1",
    "livekit-server-sdk": "^2.15.1",
    "pino": "^10.3.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.19.15",
    "@vitest/coverage-v8": "^4.1.5",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  }
}
