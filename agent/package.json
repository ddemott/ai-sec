{
  "name": "ai-sec-agent",
  "version": "0.1.0",
  "private": true,
  "description": "LiveKit voice agent worker for SecretaryHQ — replaces Vapi as the orchestrator between Telnyx (SIP) and Deepgram/OpenAI/xAI.",
  "main": "dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts dev",
    "build": "tsc -p .",
    "start": "node dist/index.js start",
    "download-files": "node dist/index.js download-files",
    "typecheck": "tsc -p . --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@livekit/agents": "^1.2.8",
    "@livekit/agents-plugin-deepgram": "^1.2.8",
    "@livekit/agents-plugin-openai": "^1.2.8",
    "@livekit/agents-plugin-silero": "^1.2.8",
    "dotenv": "^17.3.1",
    "livekit-server-sdk": "^2.15.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22.19.15",
    "tsx": "^4.19.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
