# =============================================================================
# SecretaryHQ - Production Environment Variables
# =============================================================================
# Copy this file to .env.production and fill in your values.
# Usage: ./scripts/deploy-production.sh .env.production

# === Database (Supabase) ===
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_ID.supabase.co:5432/postgres
SUPABASE_PROJECT_ID=your-project-id
SUPABASE_ACCESS_TOKEN=sbp_your-token

# === AI & Voice ===
OPENAI_API_KEY=sk-proj-...
DEEPGRAM_API_KEY=your-deepgram-key
# xAI Grok TTS (used by the LiveKit agent worker — XAI_TTS_VOICE picks one of
# eve | ara | rex | sal | leo, defaults to ara)
XAI_API_KEY=xai-...
XAI_TTS_VOICE=ara

# === Telephony (Telnyx → LiveKit) ===
# Telnyx API key authorizes phone-number purchase, SMS OTP, and number release.
TELNYX_API_KEY=KEY01...
# Telnyx SIP Connection ID — purchased numbers are routed here so calls reach
# LiveKit. Find this in the Telnyx Mission Control Portal under SIP Connections.
TELNYX_SIP_CONNECTION_ID=

# === LiveKit (voice agent) ===
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Shared secret the LiveKit agent uses to call /agent-tools/* on the backend.
AGENT_SECRET=

# === Auth ===
JWT_SECRET=generate-a-strong-random-string-at-least-32-chars
JWT_EXPIRY=8h

# === Billing (Stripe) ===
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_SOLO_PRICE_ID=price_...
STRIPE_GROWTH_PRICE_ID=price_...

# === Deployment URLs ===
NEXT_PUBLIC_API_BASE_URL=https://your-backend.railway.app
NODE_ENV=production
PORT=4001

# === Initial Admin ===
ADMIN_EMAIL=admin@secretaryhq.com
ADMIN_PASSWORD=change-this-to-something-secure
