# =============================================================================
# AI Secretary - Production Environment Variables
# =============================================================================
# Copy this file to .env.production and fill in your values.
# Usage: ./scripts/deploy-production.sh .env.production

# === Database (Supabase) ===
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_ID.supabase.co:5432/postgres
SUPABASE_PROJECT_ID=your-project-id
SUPABASE_ACCESS_TOKEN=sbp_your-token

# === AI & Voice ===
OPENAI_API_KEY=sk-proj-...
VAPI_SERVER_URL_SECRET=your-shared-secret

# === Auth ===
JWT_SECRET=generate-a-strong-random-string-at-least-32-chars
JWT_EXPIRY=8h

# === Billing (Stripe) ===
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_SOLO_PRICE_ID=price_...
STRIPE_GROWTH_PRICE_ID=price_...

# === Deployment URLs ===
NEXT_PUBLIC_API_BASE_URL=https://your-backend.railway.app
NODE_ENV=production
PORT=3000

# === Initial Admin ===
ADMIN_EMAIL=dale@ai-sec.com
ADMIN_PASSWORD=change-this-to-something-secure
