{
  "name": "ai-sec-backend",
  "version": "0.1.0",
  "private": true,
  "main": "dist/src/index.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev:backend": "ts-node-dev --respawn --transpile-only src/index.ts",
    "dev:dashboard": "cd dashboard && npm run dev",
    "test": "vitest run src/ scripts/ --fileParallelism=false",
    "test:ci": "DATABASE_URL=postgres://postgres:postgres@localhost:5433/test_db vitest run src/ scripts/ --fileParallelism=false",
    "verify:claude-md": "npx tsx scripts/verify-claude-md.ts",
    "verify:schema": "npx tsx scripts/verify-schema-alignment.ts",
    "bootstrap": "bash scripts/bootstrap.sh",
    "db:migrate": "bash scripts/setup-db.sh",
    "db:seed": "bash scripts/seed-db.sh",
    "db:rebuild": "bash scripts/rebuild-db.sh",
    "db:baseline": "bash scripts/generate-baseline.sh",
    "start": "bash scripts/start-all.sh",
    "restart": "bash scripts/restart-all.sh",
    "build": "tsc -p .",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,md}\" \"scripts/**/*.{ts,tsx,js,jsx,json}\" \"shared/**/*.{ts,tsx,js,jsx,json}\" \"*.{json,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,md}\" \"scripts/**/*.{ts,tsx,js,jsx,json}\" \"shared/**/*.{ts,tsx,js,jsx,json}\" \"*.{json,md}\"",
    "checks": "npm run format:check && npm run lint && npx tsc --noEmit && cd dashboard && npx tsc --noEmit",
    "pre-pr": "npm run checks && npm test && echo 'Consider running relevant E2E: cd dashboard && npx playwright test --grep \"<pattern>\"'",
    "create-branch": "bash scripts/create-feature-branch.sh",
    "setup-hooks": "bash scripts/setup-hooks.sh",
    "remove-hooks": "bash scripts/remove-hooks.sh",
    "prepare": "husky",
    "prepare-commit": "bash scripts/prepare-commit.sh",
    "generate-kit": "bash scripts/generate-portable-kit.sh",
    "status": "bash scripts/simulate.sh status --deep",
    "ci:status": "bash scripts/simulate.sh ci",
    "ci:watch": "bash scripts/simulate.sh ci --watch"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.2",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@logtail/pino": "^0.5.8",
    "@sentry/node": "^10.53.1",
    "@supabase/supabase-js": "^2.100.1",
    "@types/jsonwebtoken": "^9.0.10",
    "bcrypt": "^6.0.0",
    "dotenv": "^17.3.1",
    "fastify": "^5.8.4",
    "googleapis": "^171.4.0",
    "jsonwebtoken": "^9.0.3",
    "next": "^16.1.6",
    "nodemailer": "^8.0.5",
    "pdf-parse": "^2.4.5",
    "stripe": "^20.4.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^22.19.15",
    "@types/nodemailer": "^8.0.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/pg": "^8.16.0",
    "@types/testing-library__react": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitest/coverage-v8": "^4.0.18",
    "concurrently": "^9.2.1",
    "eslint": "^8.57.0",
    "husky": "^9.1.7",
    "jsdom": "^28.1.0",
    "pg": "^8.19.0",
    "prettier": "^3.3.3",
    "supabase": "^2.83.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
