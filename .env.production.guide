# =============================================================================
# SecretaryHQ - Production Environment Variables Guide
# =============================================================================
#
# This file explains where to find each value. The actual values go in
# .env.production (which is gitignored and never committed).
#
# To create/reset .env.production:
#   cp .env.production.example .env.production
#
# =============================================================================

# === Database (Supabase) ===
#
# WHERE: https://supabase.com/dashboard/projects → click your project
#   → Settings (gear) → Database → Connection string (URI)
#   NOTE: Use the Session Mode Pooler connection (port 5432 on pooler host)
#   because WSL can't reach the direct IPv6 connection.
#   Format: postgresql://postgres.PROJECT_ID:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
#
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_ID:YOUR_PASSWORD@aws-0-us-west-2.pooler.supabase.com:5432/postgres

# WHERE: https://supabase.com/dashboard/projects → click your project
#   → Settings (gear) → General → Project ID (click Copy)
#
SUPABASE_PROJECT_ID=your-project-id

# WHERE: https://supabase.com/dashboard/account/tokens
#   → Generate New Token → name it "SecretaryHQ Deploy" → copy immediately
#   (only shown once — if lost, delete and regenerate)
#
SUPABASE_ACCESS_TOKEN=sbp_your-token

# === AI & Voice ===
#
# WHERE: https://platform.openai.com → API Keys → Create new secret key
#   → All permissions → copy the sk-proj-... key
#   NOTE: Requires payment method on platform.openai.com (separate from ChatGPT subscription)
#
OPENAI_API_KEY=sk-proj-...

# WHERE: Generated by you — any random string. Must match what you enter
#   in the Vapi dashboard when configuring the agent's Server URL.
#   Generate with: openssl rand -hex 32
#
VAPI_SERVER_URL_SECRET=your-random-shared-secret

# === Phone Provisioning (Vapi) ===
#
# WHERE: https://vapi.ai → Dashboard → Account (bottom left) → API Keys
#   → Copy your Private Key (starts with va-)
#   This is used to auto-create Vapi assistants and provision phone numbers.
#   Without this, the "Activate Phone" button will be disabled.
#
VAPI_API_KEY=va-...

# === Auth ===
#
# WHERE: Generated by you — long random string for signing JWT tokens.
#   Generate with: openssl rand -hex 32
#   NEVER use the default dev secret in production.
#
JWT_SECRET=your-random-jwt-secret

# No need to change this unless you want shorter/longer sessions
JWT_EXPIRY=8h

# === Billing (Stripe) ===
#
# WHERE: https://dashboard.stripe.com → toggle "Test mode" (top-right)
#   → Developers (bottom-left) → API keys → Secret key (Standard)
#   For live: same place but with Test mode OFF (key starts with sk_live_)
#   For testing: use Test mode (key starts with sk_test_)
#
STRIPE_SECRET_KEY=sk_test_...

# WHERE: https://dashboard.stripe.com → Developers → Webhooks
#   → Add endpoint → enter your backend URL + /billing/webhook
#   → Select events: checkout.session.completed, invoice.payment_failed,
#     customer.subscription.deleted
#   → Copy the signing secret (whsec_...)
#   NOTE: Create this AFTER the backend is deployed (you need the URL first)
#
STRIPE_WEBHOOK_SECRET=whsec_...

# WHERE: https://dashboard.stripe.com → Product catalog → click each product
#   → under Pricing, click the price row → copy the price_... ID
#   NOTE: Test mode and Live mode have DIFFERENT price IDs.
#   If you created products in live mode, recreate them in test mode.
#
STRIPE_SOLO_PRICE_ID=price_...
STRIPE_GROWTH_PRICE_ID=price_...
STRIPE_PRO_PRICE_ID=price_...
STRIPE_ENTERPRISE_PRICE_ID=price_...

# === Deployment URLs ===
#
# WHERE: After deploying backend to Railway:
#   Railway dashboard → your project → your service → Settings → Networking
#   → Public Networking → Generate Domain → copy the URL
#   Format: https://your-service-name.up.railway.app
#
NEXT_PUBLIC_API_BASE_URL=https://your-backend.up.railway.app

# WHERE: Your deployed dashboard URL (Vercel, Railway, etc.)
#   Used for Stripe Checkout success/cancel redirects.
#   If dashboard runs on the same domain or you haven't deployed it yet,
#   set this to your dashboard's public URL once known.
#
DASHBOARD_URL=https://your-dashboard-domain.com

# These are fine as-is
NODE_ENV=production
PORT=3000

# === Initial Admin ===
#
# The first admin account created during deployment.
# This is what you log into the dashboard with.
#
ADMIN_EMAIL=admin@secretaryhq.com
ADMIN_PASSWORD=pick-a-secure-password
