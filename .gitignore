# Journal-loop generator output. Retired 2026-05-07 (commit 6b43c8e).
# The generator still runs on a separate schedule and recreates these
# files; gitignored so output stays untracked rather than reappearing
# in working-tree status every session.
improvement-ideas.md
.remember/

# Claude Code harness state (per-machine, not source-controlled)
.claude/

# continuously-improve loop state (per-machine, session-scoped)
.improve/

# Playwright test output (build artifact)
test-results/

# Windows "downloaded file" mark-of-the-web cruft
*:Zone.Identifier

# Local Netlify folder
.netlify

.trash/
